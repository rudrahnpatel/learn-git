{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/sw.js",
      "headers": {
        "cache-control": "public, max-age=0, must-revalidate",
        "service-worker-allowed": "/"
      },
      "continue": true
    },
    {
      "src": "/manifest.webmanifest",
      "headers": {
        "content-type": "application/manifest+json",
        "cache-control": "public, max-age=0, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "/app/",
      "status": 308,
      "headers": {
        "Location": "/app"
      }
    },
    {
      "src": "/",
      "dest": "/site/index.html"
    },
    {
      "src": "/app",
      "dest": "/index.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}
